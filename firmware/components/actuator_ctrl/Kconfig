menu "LabGuard hardware actuator control"

    config LABGUARD_ACTUATOR_FAN_GPIO
        int "Fan MOSFET gate GPIO"
        range -1 54
        default 5

    config LABGUARD_ACTUATOR_FAN_ACTIVE_LOW
        bool "Fan channel is active low"
        default n

    config LABGUARD_ACTUATOR_PUMP_GPIO
        int "Pump MOSFET gate GPIO"
        range -1 54
        default 6

    config LABGUARD_ACTUATOR_PUMP_ACTIVE_LOW
        bool "Pump channel is active low"
        default n

    config LABGUARD_ACTUATOR_LIGHT_GPIO
        int "Demo light MOSFET control GPIO"
        range -1 54
        default 32

    config LABGUARD_ACTUATOR_LIGHT_ACTIVE_LOW
        bool "Demo light channel is active low"
        default n

    config LABGUARD_ACTUATOR_LIGHT_DATA_GPIO
        int "LED strip data GPIO"
        range -1 54
        default 33

    config LABGUARD_ACTUATOR_LIGHT_LED_COUNT
        int "LED strip pixel count"
        range 1 256
        default 8
        help
            Number of WS2812/SK6812-compatible RGB pixels driven from the
            configured LED strip data GPIO.

endmenu
