build esp-idf/esp_hal_parlio/CMakeFiles/install/strip.util: CUSTOM_COMMAND esp-idf/esp_hal_parlio/all
  COMMAND = cd /home/lijiaolong/labguard/shiyanshianquan/firmware/esp_indoor/build/esp-idf/esp_hal_parlio && /usr/bin/cmake -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake
  DESC = Installing the project stripped...
  pool = console
  restat = 1

build esp-idf/esp_hal_parlio/install/strip: phony esp-idf/esp_hal_parlio/CMakeFiles/install/strip.util

