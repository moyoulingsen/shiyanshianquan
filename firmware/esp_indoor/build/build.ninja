# Utility command for edit_cache

build esp-idf/main/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/lijiaolong/labguard/shiyanshianquan/firmware/esp_indoor/build/esp-idf/main && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
