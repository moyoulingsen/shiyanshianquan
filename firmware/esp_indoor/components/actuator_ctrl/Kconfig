menu "LabGuard indoor actuator control"

    config LABGUARD_ACTUATOR_FAN_GPIO
        int "Fan MOSFET gate (IN1) GPIO"
        range -1 54
        default 5
        help
            Drives one channel of the 4-way MOSFET module. Active-high (3.3V
            turns the channel on, GND turns it off). Set to -1 to disable.

    config LABGUARD_ACTUATOR_FAN_ACTIVE_LOW
        bool "Fan channel is active low"
        default n
        help
            Most low-side N-MOS modules with optocoupler drive the load when
            the IN pin is high. Some opto-isolated boards expect active low.

    config LABGUARD_ACTUATOR_PUMP_GPIO
        int "Pump MOSFET gate (IN2) GPIO"
        range -1 54
        default 6
        help
            Drives a separate channel for the DC water pump. Set to -1 to
            disable.

    config LABGUARD_ACTUATOR_PUMP_ACTIVE_LOW
        bool "Pump channel is active low"
        default n

    config LABGUARD_ACTUATOR_ALARM_GPIO
        int "Alarm GPIO output"
        range -1 54
        default -1
        help
            Optional simple GPIO alarm output, for example a relay, active
            buzzer, or MOSFET channel. Set to -1 to disable. The addressable
            RGB strip below is controlled separately.

    config LABGUARD_ACTUATOR_ALARM_ACTIVE_LOW
        bool "Alarm GPIO output is active low"
        default n

    config LABGUARD_ACTUATOR_ALARM_STRIP_GPIO
        int "Addressable alarm light DI GPIO"
        range -1 54
        default 46
        help
            Data input pin for the 5V addressable RGB strip. Connect the strip
            DI pad to this GPIO and keep ESP32 GND common with the strip GND.
            Set to -1 to disable the strip output.

    config LABGUARD_ACTUATOR_ALARM_STRIP_LED_COUNT
        int "Addressable alarm light LED count"
        range 1 64
        default 4
        help
            Number of RGB LEDs connected in series on the strip.

    config LABGUARD_ACTUATOR_ALARM_STRIP_BRIGHTNESS
        int "Addressable alarm light brightness"
        range 1 255
        default 80
        help
            Red-channel brightness used during alarm flashing.

    config LABGUARD_ACTUATOR_ALARM_STRIP_BLINK_MS
        int "Addressable alarm light blink interval in ms"
        range 100 2000
        default 250

endmenu
